#!/usr/bin/env bash
set -euo pipefail

# Resolve the real path of this script (follows symlinks from npm global bin)
SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_PATH="$(cd "$(dirname "$SOURCE")" && pwd)"
LIUTAIO_HOME="$(cd "$SCRIPT_PATH/.." && pwd)"

# Handle --version/-v
if [[ "${1:-}" == "--version" || "${1:-}" == "-v" ]]; then
  node -e "console.log('liutaio v' + require('$LIUTAIO_HOME/package.json').version)"
  exit 0
fi

# Handle --agent-template
if [[ "${1:-}" == "--agent-template" ]]; then
  cat "$LIUTAIO_HOME/agent-template.md"
  exit 0
fi

# Delegate to run.sh with all arguments
exec "$LIUTAIO_HOME/docker/run.sh" "$@"
